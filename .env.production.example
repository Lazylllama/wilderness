# Postgres password for the bundled db service (DATABASE_URL is built from it).
POSTGRES_PASSWORD=

# Domain pointing at this machine. Thruster gets a Let's Encrypt cert for it.
# Production forces SSL, so leave this set unless you run your own TLS proxy.
TLS_DOMAIN=wilderness.example.com
APP_URL=https://wilderness.example.com

# bin/rails secret
SECRET_KEY_BASE=

# bin/rails db:encryption:init (keep these stable or encrypted columns are lost)
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# Hack Club oauth app creds
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
