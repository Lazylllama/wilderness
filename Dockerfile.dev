# syntax=docker/dockerfile:1
# Local development image. For production, see ./Dockerfile.

ARG RUBY_VERSION=3.4.10
FROM docker.io/library/ruby:${RUBY_VERSION}-slim

WORKDIR /rails

ENV BINDING="0.0.0.0" \
    BUNDLE_PATH="/usr/local/bundle"

# OS packages needed to build gems and run the app
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential curl git libjemalloc2 libpq-dev libvips libyaml-dev pkg-config sqlite3 && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Node.js, for the Vite/Inertia/React frontend
ARG NODE_MAJOR=22
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - && \
    apt-get install --no-install-recommends -y nodejs && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# foreman drives bin/dev (runs Procfile.dev: rails server + vite dev server)
RUN gem install foreman

# Non-root user matching a typical host UID/GID, so bind-mounted files
# created in the container aren't owned by root on the host.
RUN groupadd --gid 1000 rails && \
    useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash rails && \
    mkdir -p /usr/local/bundle /rails/node_modules && \
    chown -R rails:rails /usr/local/bundle /rails
USER rails

CMD ["bin/dev"]
